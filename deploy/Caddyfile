{
    admin off
}

:8080 {
    header Cache-Control "no-cache"
    basic_auth {
        {$SENTINEL_ADMIN_USER} {$SENTINEL_ADMIN_PASSWORD_HASH}
    }
    handle_path /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
