FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements-cpu.txt /tmp/requirements-cpu.txt
RUN pip install --no-cache-dir torch==2.12.1 --index-url https://download.pytorch.org/whl/cpu \
    && python -c "from pathlib import Path; p=Path('/tmp/requirements-cpu.txt'); p.write_text('\\n'.join(x for x in p.read_text().splitlines() if not x.startswith(('--extra-index-url', 'torch=='))) + '\\n')" \
    && pip install --no-cache-dir -r /tmp/requirements-cpu.txt
ENV HF_HOME=/opt/sentinel-models
COPY scripts/cache_embeddings.py /app/scripts/cache_embeddings.py
RUN python scripts/cache_embeddings.py
COPY backend/ /app/backend/
COPY docs/ /app/docs/
COPY scripts/initialize_storage.py /app/scripts/initialize_storage.py
WORKDIR /app/backend
ENV PYTHONPATH=/app/backend
EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && python /app/scripts/initialize_storage.py && exec python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]
